<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude databases from backup to prevent SQLiteCantOpenDatabaseException after restore -->
        <exclude domain="database" path="."/>
        <!-- Exclude shared preferences to prevent exporting sensitive session state and auth credentials -->
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
